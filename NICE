-- 1. Helper: Get Account Age
local function getAccountAge()
    local createdDate = nil
    pcall(function()
        createdDate = PLAYER.Created
    end)
    if not createdDate then return "Unknown" end

    local createdUnix
    pcall(function()
        createdUnix = createdDate.UnixTimestamp
    end)
    if not createdUnix then return "Unknown" end

    local now = os.time()
    local seconds = now - createdUnix
    local days = math.floor(seconds / 86400)
    local hours = math.floor((seconds % 86400) / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    
    if days > 0 then return days .. "d"
    elseif hours > 0 then return hours .. "h"
    else return minutes .. "m" end
end

-- 2. Helper: Get Sea Level
local function getSeaLevel()
    local char = PLAYER.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        return "Unknown"
    end
    local z = char.HumanoidRootPart.Position.Z
    if z < 2000 then return "1"
    elseif z < 4000 then return "2"
    else return "3" end
end

