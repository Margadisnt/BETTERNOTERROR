-- Helper: Check if a string is a known fruit
local function isKnownFruit(name)
    if type(name) ~= "string" then return false end
    return FRUIT_DB[name] ~= nil
end

-- Helper: Get Rarity
local function getRarity(name)
    return FRUIT_DB[name] or "Unknown"
end

-- 2. Memory Scanner (getgc)
local function scanMemoryForFruits()
    local foundFruits = {}
    local seen = {}
    
    -- If getgc is not available, return empty
    if type(getgc) ~= "function" then
        print("[BF Script] getgc() not available in this executor.")
        return foundFruits
    end
    
    local gc = getgc()
    
    for _, obj in ipairs(gc) do
        if type(obj) == "table" then
            -- We are looking for a table that likely represents the inventory
            -- Structure usually: { ["Fruits"] = { ["Kitsune"] = 1, ... } } 
            -- OR a flat table: { ["Kitsune"] = 1, ["Dragon"] = 2 }
            
            for key, value in pairs(obj) do
                -- Case 1: The key itself is a fruit name
                if isKnownFruit(key) then
                    -- Value should be a number (quantity) or a table with quantity
                    local qty = 1
                    if type(value) == "number" then
                        qty = value
                    elseif type(value) == "table" then
                        -- Some structures store { Amount = 1 }
                        if value.Amount then
                            qty = value.Amount
                        elseif value.Quantity then
                            qty = value.Quantity
                        end
                    end
                    
                    if not seen[key] then
                        seen[key] = true
                        foundFruits[key] = qty
                    end
                end
                
                -- Case 2: The key is "Fruits" and the value is a table of fruits
                if key == "Fruits" and type(value) == "table" then
                    for fruitName, fruitQty in pairs(value) do
                        if isKnownFruit(fruitName) then
                            local qty = 1
                            if type(fruitQty) == "number" then
                                qty = fruitQty
                            elseif type(fruitQty) == "table" and fruitQty.Amount then
                                qty = fruitQty.Amount
                            end
                            
                            if not seen[fruitName] then
                                seen[fruitName] = true
                                foundFruits[fruitName] = qty
                            end
                        end
                    end
                end
            end
        end
    end
    
    return foundFruits
end

-- 3. Module Scanner (Require)
local function scanModulesForFruits()
    local foundFruits = {}
    local seen = {}
    
    local replicatedStorage = game:GetService("ReplicatedStorage")
    
    -- Common module names in BF
    local possibleModules = {"Inventory", "Modules", "Shared", "InventoryModule", "Data"}
    
    for _, modName in ipairs(possibleModules) do
        local mod = replicatedStorage:FindFirstChild(modName)
        if mod and mod:IsA("ModuleScript") then
            pcall(function()
                local inventoryData = require(mod)
                -- The module might return a table directly
                if type(inventoryData) == "table" then
                    -- Check if it has a Fruits key
                    if inventoryData.Fruits and type(inventoryData.Fruits) == "table" then
                        for fruitName, qty in pairs(inventoryData.Fruits) do
                            if isKnownFruit(fruitName) and not seen[fruitName] then
                                seen[fruitName] = true
                                local q = 1
                                if type(qty) == "number" then q = qty
                                elseif type(qty) == "table" and qty.Amount then q = qty.Amount
                                end
                                foundFruits[fruitName] = q
                            end
                        end
                    else
                        -- Check if it's a flat table of fruits
                        for key, value in pairs(inventoryData) do
                            if isKnownFruit(key) and not seen[key] then
                                seen[key] = true
                                local q = 1
                                if type(value) == "number" then q = value
                                elseif type(value) == "table" and value.Amount then q = value.Amount
                                end
                                foundFruits[key] = q
                            end
                        end
                    end
                end
            end)
        end
    end
    
    return foundFruits
end

-- 4. UI Fallback (Last Resort)
local function scanUIForFruits()
    local foundFruits = {}
    local seen = {}
    local playerGui = PLAYER:FindFirstChild("PlayerGui")
    
    if playerGui then
        for _, gui in pairs(playerGui:GetDescendants()) do
            if gui:IsA("TextLabel") and gui.Text and gui.Text ~= "" then
                local text = gui.Text
                if isKnownFruit(text) and not seen[text] then
                    seen[text] = true
                    foundFruits[text] = 1
                end
            end
        end
    end
    return foundFruits
end

-- 5. Main Get Fruits Function
local function getStoredFruits()
    print("[BF Script] Scanning Memory (getgc)...")
    local fruits = scanMemoryForFruits()
    
    if next(fruits) == nil then
        print("[BF Script] Memory scan empty. Scanning Modules...")
        fruits = scanModulesForFruits()
    end
    
    if next(fruits) == nil then
        print("[BF Script] Module scan empty. Scanning UI...")
        fruits = scanUIForFruits()
    end
    
    -- Convert table to list for sorting
    local fruitList = {}
    for name, qty in pairs(fruits) do
        table.insert(fruitList, {
            name = name,
            rarity = getRarity(name),
            quantity = qty
        })
    end
    
    -- Sort
    local rarityOrder = {["Mythical"] = 1, ["Legendary"] = 2, ["Rare"] = 3, ["Uncommon"] = 4, ["Common"] = 5, ["Unknown"] = 6}
    table.sort(fruitList, function(a, b)
        local orderA = rarityOrder[a.rarity] or 7
        local orderB = rarityOrder[b.rarity] or 7
        if orderA ~= orderB then return orderA < orderB end
        return a.name < b.name
    end)
    
    return fruitList
end

-- 6. Account Age & Sea Level
local function getAccountAge()
    local createdDate = PLAYER.Created
    local now = os.time()
    local seconds = now - createdDate.UnixTimestamp
    local days = math.floor(seconds / 86400)
    if days > 0 then return days .. "d" else return math.floor(seconds/3600) .. "h" end
end

local function getSeaLevel()
    local char = PLAYER.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return "Unknown" end
    local z = char.HumanoidRootPart.Position.Z
    if z < 2000 then return "1" elseif z < 4000 then return "2" else return "3" end
end

-- 7. Build Content
local function buildContent()
    local fruits = getStoredFruits()
    local lines = {}
    table.insert(lines, "**" .. PLAYER_NAME .. "** | Age: " .. getAccountAge() .. " | Sea: " .. getSeaLevel())
    table.insert(lines, "Fruits (" .. #fruits .. "):")
    
    if #fruits > 0 then
        for _, fruit in ipairs(fruits) do
            table.insert(lines, "• [" .. fruit.rarity .. "] " .. fruit.name .. " (" .. fruit.quantity .. ")")
        end
    else
        table.insert(lines, "❌ No fruits found.")
    end
    
    local content = table.concat(lines, "\n")
    if #content > 1900 then
        content = content:sub(1, 1900) .. "\n... [Truncated]"
    end
    return content
end

