-- 4. Helper: Get Stored Fruits (Precision Scanner)
local function getStoredFruits()
    local fruits = {}
    local seen = {}
    local maxItems = 25 -- Reduced limit to ensure safety

    local function addFruit(name, qty)
        if name and not seen[name] and #fruits < maxItems then
            seen[name] = true
            table.insert(fruits, {
                name = name,
                rarity = getRarity(name),
                quantity = qty or 1
            })
        end
    end

    -- Attempt 1: ReplicatedStorage Data Model
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local possibleFolders = {"Inventory", "PlayerData", "Data", "Fruits"}
    
    for _, folderName in ipairs(possibleFolders) do
        local folder = replicatedStorage:FindFirstChild(folderName)
        if folder then
            for _, item in pairs(folder:GetChildren()) do
                if item:IsA("ValueBase") then
                    addFruit(item.Name, item.Value)
                elseif item:IsA("Tool") then
                    addFruit(item.Name, 1)
                else
                    local qty = item:GetAttribute("Quantity") or item:GetAttribute("Count") or 1
                    addFruit(item.Name, qty)
                end
            end
        end
    end

    -- Attempt 2: UI Scraping (Targeted)
    if #fruits == 0 then
        print("[BF Script] Data model empty. Targeting Inventory UI...")
        local playerGui = PLAYER:FindFirstChild("PlayerGui")
        if playerGui then
            -- Find the specific Inventory ScreenGui
            local inventoryGui = nil
            for _, gui in pairs(playerGui:GetChildren()) do
                if gui:IsA("ScreenGui") then
                    -- Check for common inventory GUI names
                    if gui.Name:lower():find("inventory") or gui.Name:lower():find("bag") or gui.Name:lower():find("storage") then
                        inventoryGui = gui
                        break
                    end
                    -- Fallback: Check if it has a Frame named "InventoryFrame"
                    if gui:FindFirstChild("InventoryFrame") or gui:FindFirstChild("Inventory") then
                        inventoryGui = gui
                        break
                    end
                end
            end
            
            if inventoryGui then
                print("[BF Script] Found Inventory GUI: " .. inventoryGui.Name)
                for _, label in pairs(inventoryGui:GetDescendants()) do
                    if label:IsA("TextLabel") and label.Text and label.Text ~= "" and #fruits < maxItems then
                        local text = label.Text
                        local lowerText = text:lower()
                        
                        -- Strict Filtering for Inventory Items
                        if not lowerText:find("inventory") 
                            and not lowerText:find("close") 
                            and not lowerText:find("sell") 
                            and not lowerText:find("buy")
                            and not lowerText:find("equip")
                            and not lowerText:find("quantity")
                            and not lowerText:find("points")
                            and not lowerText:find("level")
                            and not lowerText:find("health")
                            and not lowerText:find("stamina")
                            and not lowerText:find("fruits")
                            and not lowerText:find("materials")
                            and not lowerText:find("weapons")
                            and #text > 2 and #text < 20 then -- Name length filter
                            addFruit(text, 1)
                        end
                    end
                end
            else
                print("[BF Script] No specific Inventory GUI found. Falling back to Backpack.")
                if PLAYER.Backpack then
                    for _, tool in pairs(PLAYER.Backpack:GetChildren()) do
                        if tool:IsA("Tool") then
                            addFruit(tool.Name, 1)
                        end
                    end
                end
            end
        end
    end
    
    -- Sort
    local rarityOrder = {["Mythical"] = 1, ["Legendary"] = 2, ["Rare"] = 3, ["Uncommon"] = 4, ["Common"] = 5, ["Unknown"] = 6}
    table.sort(fruits, function(a, b)
        local orderA = rarityOrder[a.rarity] or 7
        local orderB = rarityOrder[b.rarity] or 7
        if orderA ~= orderB then return orderA < orderB end
        return a.name < b.name
    end)
    
    return fruits
end

-- 5. Build Message Content
local function buildContent()
    local accountAge = getAccountAge()
    local seaLevel = getSeaLevel()
    local fruits = getStoredFruits()
    
    local lines = {}
    table.insert(lines, "**" .. PLAYER_NAME .. "** | Age: " .. accountAge .. " | Sea: " .. seaLevel)
    table.insert(lines, "Fruits (" .. #fruits .. "):")
    
    if #fruits > 0 then
        for _, fruit in ipairs(fruits) do
            table.insert(lines, "• [" .. fruit.rarity .. "] " .. fruit.name .. " (" .. fruit.quantity .. ")")
        end
    else
        table.insert(lines, "❌ No fruits found.")
    end
    
    local finalContent = table.concat(lines, "\n")
    
    -- Safety Check: If still too long, truncate
    if #finalContent > 1900 then
        finalContent = finalContent:sub(1, 1900) .. "\n... [Truncated]"
    end
    
    return finalContent
end

-- 6. Robust HTTP Sender
local function sendToDiscord()
    local content = buildContent()
    
    local payload = {
        username = "BF Notifier",
        avatar_url = "https://bloxfruits.fandom.com/wiki/Blox_Fruits?action=raw&file=Blox_Fruits_Logo.png",
        content = content
    }
    
    local httpService = game:GetService("HttpService")
    local encodedPayload = httpService:JSONEncode(payload)

    local httpFunc = nil
    if type(request) == "function" then
        httpFunc = request
    elseif type(http_request) == "function" then
        httpFunc = http_request
    elseif type(http) == "function" then
        httpFunc = http
    else
        print("[BF Script] ❌ No HTTP function found.")
        return false
    end

    local success, response = pcall(function()
        return httpFunc({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = encodedPayload
        })
    end)

    if success and response and response.Success then
        print("[BF Script] ✅ Successfully sent to Discord.")
        return true
    else
        print("[BF Script] ❌ Failed to send.")
        if not success then
            print("Error: " .. tostring(response))
        else
            print("Status: " .. tostring(response.StatusCode))
            print("Body: " .. tostring(response.Body))
        end
        return false
    end
end

